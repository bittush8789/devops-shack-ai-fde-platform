# ==========================================
# OpenAI API Configuration for AI Assistant
# ==========================================

# Your OpenAI API key (starts with sk-...)
OPENAI_API_KEY=your_openai_api_key_here

# OpenAI Model to use (e.g., gpt-4o, gpt-4o-mini, gpt-3.5-turbo)
OPENAI_MODEL=gpt-4o-mini

# Service Port
PORT=8088

# Downstream Microservices URLs
CATALOG_URL=http://localhost:8082
INVENTORY_URL=http://localhost:8083

# Chroma DB Vector Database configuration
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_COLLECTION=polyglot_store_knowledge
